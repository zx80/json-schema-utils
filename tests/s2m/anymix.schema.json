{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stuff": {
      "$ref": "#/$defs/stuff"
    },
    "foo": { "type": "string" },
    "bla": { "type": "string" }
  },
  "anyOf": [
    { "required": [ "foo" ] },
    { "required": [ "bla" ] }
  ],
  "$defs": {
    "stuff": {
      "type": "string",
      "format": "uri"
    }
  }
}
